# Byte-compiled / cache
__pycache__/
*.py[cod]
*.pyc

# Jupyter
.ipynb_checkpoints/

# Environments
.venv/
venv/
env/

# Data pipeline output (regenerated by src/01_download_data.py). Everything
# in output/ is ignored EXCEPT the two raw parquet snapshots checked in
# explicitly so comparison.ipynb runs out of the box without a fresh
# download -- prices_selected/universe.parquet, returns_*.parquet, and the
# CSV/txt reports are all cheaply regenerated by src/01_download_data.py and
# src/02_universe_selection.py and are not committed.
output/*
!output/prices_full_history.parquet
!output/volumes_full_history.parquet

# OS / editor cruft
.DS_Store
Thumbs.db
.vscode/
.idea/
